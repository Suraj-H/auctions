                  "pm.test(\"replayed is false\", () => pm.expect(body.replayed).to.eql(false));",
                  "pm.collectionVariables.set(\"seqNoKey\", body.seq);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bid",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auction_id\": \"{{auctionId}}\",\n  \"user_id\": \"{{alice}}\",\n  \"amount\": 85000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Exactly the body the brief specifies, no header."
          }
        },
        {
          "name": "13. That same body again — replayed anyway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"outcome is ACCEPTED_LEADING\", () => pm.expect(body.outcome).to.eql(\"ACCEPTED_LEADING\"));",
                  "pm.test(\"replayed is true\", () => pm.expect(body.replayed).to.eql(true));",
                  "pm.test(\"same seq as the original\", () => pm.expect(body.seq).to.eql(Number(pm.collectionVariables.get(\"seqNoKey\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bid",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auction_id\": \"{{auctionId}}\",\n  \"user_id\": \"{{alice}}\",\n  \"amount\": 85000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "With no key the request fingerprint becomes the key, so the brief’s contract is still retry-safe. Weaker than a real key: a deliberate resend is byte-identical to a retry and replays too."
          }
        }
      ]
    },
    {
      "name": "4 — Bidding on your own top bid",
      "item": [
        {
          "name": "14. Alice, already leading, raises herself to 900.00",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"outcome is ACCEPTED_SELF_RAISE\", () => pm.expect(body.outcome).to.eql(\"ACCEPTED_SELF_RAISE\"));",
                  "pm.test(\"current top is 90000\", () => pm.expect(body.currentTopCents).to.eql(90000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bid",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auction_id\": \"{{auctionId}}\",\n  \"user_id\": \"{{alice}}\",\n  \"amount\": 90000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Accepted, and typed separately. Refusing would block the case where the reserve is not yet met and a self-raise is the only path to a sale — and would make a refused self-bid indistinguishable from a lost one to anyone reading the ledger later."
          }
        }
      ]
    },
