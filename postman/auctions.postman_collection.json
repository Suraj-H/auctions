                  "pm.test(\"replayed is true\", () => pm.expect(body.replayed).to.eql(true));",
                  "pm.test(\"same seq as the original\", () => pm.expect(body.seq).to.eql(Number(pm.collectionVariables.get(\"seqCarol\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "\"{{retryKey}}\""
              }
            ],
            "url": "{{baseUrl}}/bid",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auction_id\": \"{{auctionId}}\",\n  \"user_id\": \"{{carol}}\",\n  \"amount\": 80000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The IETF draft types the header as a quoted structured string; Stripe and curl send it bare. Both spellings must mean one key, or an RFC-following client and a Stripe-following client send the same retry and get two bids."
          }
        },
        {
          "name": "12. Alice bids 850.00 with no key at all",
          "event": [
