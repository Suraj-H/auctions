    {
      "name": "3 — Retries and idempotency",
      "item": [
        {
          "name": "08. Carol bids 800.00 with an Idempotency-Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"outcome is ACCEPTED_LEADING\", () => pm.expect(body.outcome).to.eql(\"ACCEPTED_LEADING\"));",
                  "pm.test(\"current top is 80000\", () => pm.expect(body.currentTopCents).to.eql(80000));",
                  "pm.test(\"replayed is false\", () => pm.expect(body.replayed).to.eql(false));",
                  "pm.collectionVariables.set(\"seqCarol\", body.seq);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{retryKey}}"
              }
            ],
            "url": "{{baseUrl}}/bid",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auction_id\": \"{{auctionId}}\",\n  \"user_id\": \"{{carol}}\",\n  \"amount\": 80000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A normal bid that happens to carry a retry key."
          }
        },
        {
          "name": "09. The same request again — a network retry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"outcome is ACCEPTED_LEADING\", () => pm.expect(body.outcome).to.eql(\"ACCEPTED_LEADING\"));",
                  "pm.test(\"current top is 80000\", () => pm.expect(body.currentTopCents).to.eql(80000));",
                  "pm.test(\"replayed is true\", () => pm.expect(body.replayed).to.eql(true));",
                  "pm.test(\"same seq as the original\", () => pm.expect(body.seq).to.eql(Number(pm.collectionVariables.get(\"seqCarol\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{retryKey}}"
              }
            ],
            "url": "{{baseUrl}}/bid",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auction_id\": \"{{auctionId}}\",\n  \"user_id\": \"{{carol}}\",\n  \"amount\": 80000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "This is the case the whole layer exists for. Without it the retry would be judged afresh, found not strictly higher than Carol’s own 800.00, and refused — telling her she lost an auction she is winning. Same seq, same price, replayed: true."
          }
        },
